{%- liquid
  assign cards = section.blocks | where: 'type', 'card'
  assign benefits = section.blocks | where: 'type', 'benefit'
-%}

<section class="yk-season" aria-labelledby="YkSeasonTitle-{{ section.id }}" data-yk-season>
  <div class="yk-season__inner">
    <div class="yk-season__header">
      {%- if section.settings.title != blank -%}
        <h2 class="yk-season__title" id="YkSeasonTitle-{{ section.id }}">{{ section.settings.title | escape | newline_to_br }}</h2>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <div class="yk-season__intro">{{ section.settings.intro }}</div>
      {%- endif -%}
    </div>

    {%- if cards.size > 0 -%}
      <div class="yk-season__cards" data-yk-season-track>
        {%- for block in cards -%}
          <div class="yk-season__card" style="--yk-overlay: {{ block.settings.overlay | divided_by: 100.0 }};" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 1400
                | image_tag:
                  class: 'yk-season__card-image',
                  loading: 'lazy',
                  widths: '400, 700, 1000, 1400',
                  sizes: '(min-width: 960px) 45vw, 92vw',
                  alt: ''
              }}
            {%- elsif block.settings.fallback_image != 'none' -%}
              <img
                class="yk-season__card-image"
                src="{{ block.settings.fallback_image | append: '.jpg' | asset_url }}"
                alt=""
                width="1100"
                height="1100"
                loading="lazy"
              >
            {%- endif -%}
            <div class="yk-season__card-text">{{ block.settings.text }}</div>
          </div>
        {%- endfor -%}
      </div>
      {%- if cards.size > 1 -%}
        <div class="yk-season__dots" aria-hidden="true">
          {%- for block in cards -%}
            <span class="yk-season__dot{% if forloop.first %} is-active{% endif %}"></span>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <h3 class="yk-season__subheading">{{ section.settings.subheading | escape }}</h3>
    {%- endif -%}

    {%- if benefits.size > 0 -%}
      <ol class="yk-season__benefits" role="list">
        {%- for block in benefits -%}
          <li class="yk-season__benefit" {{ block.shopify_attributes }}>
            <span class="yk-season__number">{{ forloop.index }}</span>
            <span class="yk-season__benefit-text">{{ block.settings.text | escape | newline_to_br }}</span>
          </li>
        {%- endfor -%}
      </ol>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "YK Season",
  "class": "yk-season-section",
  "settings": [
    { "type": "textarea", "id": "title", "label": "Heading", "default": "Why do you need to Season?" },
    { "type": "richtext", "id": "intro", "label": "Intro text" },
    { "type": "text", "id": "subheading", "label": "Benefits heading", "default": "Some of the benefits of purchasing carbon steel cookware are as follows:" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "limit": 4,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Background image" },
        {
          "type": "select",
          "id": "fallback_image",
          "label": "Default background",
          "info": "Used when no image is selected",
          "default": "yk-season-stone",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "yk-season-stone", "label": "Stone" },
            { "value": "yk-season-wood", "label": "Wood" }
          ]
        },
        { "type": "range", "id": "overlay", "label": "Image darkening", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 30 },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Card text</p>" }
      ]
    },
    {
      "type": "benefit",
      "name": "Benefit",
      "limit": 12,
      "settings": [
        { "type": "textarea", "id": "text", "label": "Text", "default": "Benefit text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "YK Season",
      "blocks": [
        { "type": "card" },
        { "type": "card", "settings": { "fallback_image": "yk-season-wood", "overlay": 50 } },
        { "type": "benefit" },
        { "type": "benefit" },
        { "type": "benefit" }
      ]
    }
  ]
}
{% endschema %}
