                    focal_point: section.settings.focal_point,
                    animate: true,
                    prioritize_loading: true
                  -%}
  to: '{%- render ''image'' with wrapper_class, wrapper_class: "recipe-article__image-inner",
    image: article.image, sizes: "100vw", focal_point: section.settings.focal_point,
    animate: true, prioritize_loading: true -%}'
  position: 1290..1499
