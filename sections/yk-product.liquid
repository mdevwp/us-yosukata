{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_tags = product.tags | join: '|' | downcase | split: '|'
  assign badge_1_tag = section.settings.badge_1_tag | downcase | strip
  assign badge_2_tag = section.settings.badge_2_tag | downcase | strip
  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value | default: 0
  assign form_id = 'YkProductForm-' | append: section.id
  assign yk_free_shipping = ''
  if settings.free_shipping_threshold != blank
    assign yk_free_shipping = settings.free_shipping_threshold | times: 100 | money_without_trailing_zeros
  endif

  assign low_stock = false
  if current_variant.available and current_variant.inventory_management == 'shopify' and current_variant.inventory_policy == 'deny'
    if current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= section.settings.low_stock_threshold
      assign low_stock = true
    endif
  endif

  assign crumb_collection = collection
  if crumb_collection == blank
    for product_collection in product.collections
      unless product_collection.handle == 'all' or product_collection.handle == 'frontpage'
        assign crumb_collection = product_collection
        break
      endunless
    endfor
  endif
-%}

<section
  class="yk-product{% unless product.available %} is-sold-out{% endunless %}"
  style="--yk-badge-1-bg: {{ section.settings.badge_1_color }}; --yk-badge-1-text: {{ section.settings.badge_1_text_color }}; --yk-badge-2-bg: {{ section.settings.badge_2_color }}; --yk-badge-2-text: {{ section.settings.badge_2_text_color }};"
  data-yk-product
  data-section-id="{{ section.id }}"
>
  <div class="yk-product__inner">
    {%- if section.settings.show_breadcrumbs -%}
      <nav class="yk-product__crumbs" aria-label="Breadcrumbs">
        <a href="{{ routes.root_url }}">{{ 'general.navigation.home' | t }}</a>
        {%- if crumb_collection != blank -%}
          <span aria-hidden="true">|</span>
          <a href="{{ crumb_collection.url }}">{{ crumb_collection.title | escape }}</a>
        {%- endif -%}
        <span aria-hidden="true">|</span>
        <span aria-current="page">{{ product.title | escape }}</span>
      </nav>
    {%- endif -%}

    <div class="yk-product__gallery" data-yk-gallery>
      <div class="yk-gallery__main" data-yk-gallery-main>
        <ul class="yk-gallery__track" role="list" data-yk-gallery-track>
          {%- for media in product.media -%}
            <li
              class="yk-gallery__slide yk-gallery__slide--{{ media.media_type }}"
              data-media-id="{{ media.id }}"
              {% unless forloop.first %}aria-hidden="true"{% endunless %}
            >
              {%- case media.media_type -%}
                {%- when 'image' -%}
                  {{
                    media
                    | image_url: width: 1600
                    | image_tag:
                      class: 'yk-gallery__image',
                      loading: 'lazy',
                      fetchpriority: 'auto',
                      widths: '400, 720, 1000, 1400, 1600',
                      sizes: '(min-width: 960px) 50vw, 92vw',
                      alt: media.alt
                      | default: product.title
                  }}
                {%- when 'video' -%}
                  {{ media | video_tag: controls: true, preload: 'metadata', class: 'yk-gallery__video' }}
                {%- when 'external_video' -%}
                  {{ media | external_video_tag: class: 'yk-gallery__video' }}
                {%- when 'model' -%}
                  {{ media | model_viewer_tag: class: 'yk-gallery__model' }}
              {%- endcase -%}
            </li>
          {%- else -%}
            <li class="yk-gallery__slide">{{ 'product-1' | placeholder_svg_tag: 'yk-gallery__image yk-gallery__image--placeholder' }}</li>
          {%- endfor -%}
        </ul>

        {%- if product.media.size > 0 -%}
          <button class="yk-gallery__zoom" type="button" aria-label="{{ section.settings.zoom_label | escape }}" aria-pressed="false" data-yk-gallery-zoom>
            {% render 'yk-icon', icon: 'zoom-in' %}
          </button>
          <span class="yk-gallery__lens" aria-hidden="true" data-yk-gallery-lens></span>
        {%- endif -%}

        {%- if product.media.size > 1 -%}
          <div class="yk-gallery__nav">
            <button class="yk-gallery__arrow" type="button" aria-label="{{ 'general.accessibility.previous' | t }}" data-yk-gallery-prev>
              {% render 'yk-icon', icon: 'arrow-left' %}
            </button>
            <span class="yk-gallery__counter" aria-live="polite"><span data-yk-gallery-current>1</span>/{{ product.media.size }}</span>
            <button class="yk-gallery__arrow" type="button" aria-label="{{ 'general.accessibility.next' | t }}" data-yk-gallery-next>
              {% render 'yk-icon', icon: 'arrow-right' %}
            </button>
          </div>
          <div class="yk-gallery__dots" aria-hidden="true">
            {%- for media in product.media -%}
              <span class="yk-gallery__dot{% if forloop.first %} is-active{% endif %}"></span>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- if product.media.size > 1 -%}
        <ul class="yk-gallery__thumbs{% if product.media.size > 5 %} is-collapsed{% endif %}" role="list" data-yk-gallery-thumbs>
          {%- for media in product.media -%}
            <li class="yk-gallery__thumb-item">
              <button
                class="yk-gallery__thumb{% if forloop.first %} is-active{% endif %}"
                type="button"
                aria-label="{{ 'general.accessibility.image_thumbail' | t }} {{ forloop.index }}"
                data-yk-gallery-thumb="{{ forloop.index0 }}"
              >
                {{ media.preview_image | image_url: width: 300 | image_tag: loading: 'lazy', alt: '', class: 'yk-gallery__thumb-image' }}
              </button>
            </li>
          {%- endfor -%}
          {%- if product.media.size > 5 -%}
            <li class="yk-gallery__thumb-item yk-gallery__thumb-item--more">
              <button class="yk-gallery__thumb yk-gallery__thumb--more" type="button" aria-label="{{ section.settings.more_media_label | escape }}" data-yk-gallery-more>
                {% render 'yk-icon', icon: 'plus' %}
              </button>
            </li>
          {%- endif -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="yk-product__info">
      {%- form 'product', product, id: form_id, class: 'yk-product__form', novalidate: 'novalidate', data-yk-product-form: '' -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-yk-variant-id>
      {%- endform -%}

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            <div class="yk-product__app">{% render block %}</div>

          {%- when 'badges' -%}
            {%- liquid
              assign has_badge_1 = false
              assign has_badge_2 = false
              if badge_1_tag != blank and product_tags contains badge_1_tag
                assign has_badge_1 = true
              endif
              if badge_2_tag != blank and product_tags contains badge_2_tag
                assign has_badge_2 = true
              endif
            -%}
            <div class="yk-product__badges" {{ block.shopify_attributes }}>
              {%- if product.available -%}
                {%- if has_badge_1 -%}
                  <span class="yk-product__badge yk-product__badge--1">{{ section.settings.badge_1_label | default: section.settings.badge_1_tag | escape }}</span>
                {%- endif -%}
                {%- if has_badge_2 -%}
                  <span class="yk-product__badge yk-product__badge--2">{{ section.settings.badge_2_label | default: section.settings.badge_2_tag | escape }}</span>
                {%- endif -%}
                {%- if low_stock -%}
                  <span class="yk-product__stock">{{ block.settings.low_stock_text | escape }}</span>
                {%- endif -%}
              {%- else -%}
                <span class="yk-product__badge yk-product__badge--sold-out">{{ block.settings.sold_out_text | escape }}</span>
              {%- endif -%}
            </div>

          {%- when 'title' -%}
            <h1 class="yk-product__title" {{ block.shopify_attributes }}>{{ product.title | escape }}</h1>

          {%- when 'price' -%}
            <div class="yk-product__price-row" {{ block.shopify_attributes }}>
              <p class="yk-product__price" data-yk-price>
                {%- if current_variant.compare_at_price > current_variant.price and block.settings.show_compare_price -%}
                  <span class="visually-hidden">{{ 'products.product.sale_price' | t }}</span>
                  {{ current_variant.price | money }}
                  <s class="yk-product__compare">{{ current_variant.compare_at_price | money }}</s>
                {%- else -%}
                  {{ current_variant.price | money }}
                {%- endif -%}
              </p>
              {%- if rating_count > 0 -%}
                {%- assign rating_value = rating.rating | times: 5.0 | divided_by: rating.scale_max | round -%}
                <a class="yk-product__rating" href="#{{ block.settings.reviews_anchor | default: 'judgeme_product_reviews' }}" aria-label="{{ rating.rating | round: 1 }} / {{ rating.scale_max }}, {{ rating_count }}">
                  {%- for i in (1..5) -%}
                    <span class="yk-product__star{% if i > rating_value %} yk-product__star--empty{% endif %}">{% render 'yk-icon', icon: 'star' %}</span>
                  {%- endfor -%}
                  <span class="yk-product__rating-count">({{ rating_count }})</span>
                </a>
              {%- endif -%}
            </div>

          {%- when 'text' -%}
            {%- liquid
              assign block_text = block.settings.text
              if block.settings.metafield != blank
                assign metafield_path = block.settings.metafield | strip | split: '.'
                assign text_metafield = product.metafields[metafield_path[0]][metafield_path[1]]
                if text_metafield != blank
                  if text_metafield.type == 'rich_text_field'
                    assign block_text = text_metafield | metafield_tag
                  else
                    assign block_text = text_metafield.value | escape | newline_to_br | prepend: '<p>' | append: '</p>'
                  endif
                endif
              endif
            -%}
            {%- if block_text == blank -%}
              {%- comment -%} Nothing filled in: subtitle from the tags, body text from the first paragraph of the description {%- endcomment -%}
              {%- if block.settings.style == 'subtitle' -%}
                {%- capture block_text -%}{% render 'yk-product-subtitle', product: product %}{%- endcapture -%}
              {%- elsif block.settings.metafield contains 'short_description' -%}
                {%- capture block_text -%}{% render 'yk-product-short-text', product: product %}{%- endcapture -%}
              {%- endif -%}
            {%- endif -%}
            {%- if block_text != blank -%}
              <div class="yk-product__text yk-product__text--{{ block.settings.style }}" {{ block.shopify_attributes }}>{{ block_text }}</div>
            {%- endif -%}

          {%- when 'callout' -%}
            <div class="yk-product__callout" {{ block.shopify_attributes }}>
              {%- if block.settings.icon != 'none' -%}{% render 'yk-icon', icon: block.settings.icon %}{%- endif -%}
              <div class="yk-product__callout-text">{{ block.settings.text }}</div>
            </div>

          {%- when 'variant_picker' -%}
            {%- unless product.has_only_default_variant -%}
              <div class="yk-product__variants" {{ block.shopify_attributes }} data-yk-variant-picker>
                {%- for option in product.options_with_values -%}
                  <fieldset class="yk-product__option">
                    <legend class="yk-product__option-name">{{ option.name | escape }}</legend>
                    <div class="yk-product__option-values">
                      {%- for value in option.values -%}
                        <label class="yk-product__option-value{% unless value.available %} is-unavailable{% endunless %}">
                          <input
                            type="radio"
                            name="{{ section.id }}-{{ option.position }}"
                            value="{{ value | escape }}"
                            {% if option.selected_value == value %}checked{% endif %}
                            data-yk-option="{{ forloop.parentloop.index0 }}"
                          >
                          <span>{{ value | escape }}</span>
                        </label>
                      {%- endfor -%}
                    </div>
                  </fieldset>
                {%- endfor -%}
                <script type="application/json" data-yk-variants>{{ product.variants | json }}</script>
              </div>
            {%- endunless -%}

          {%- when 'buy_buttons' -%}
            <div class="yk-product__buy" {{ block.shopify_attributes }} data-yk-buy>
              <div class="yk-product__buy-row" data-yk-buy-available{% unless current_variant.available %} hidden{% endunless %}>
                {%- if block.settings.show_quantity -%}
                  <div class="yk-product__qty" data-yk-qty>
                    <button type="button" aria-label="{{ 'general.accessibility.quantity_subtract' | t }}" data-yk-qty-step="-1">−</button>
                    <input type="number" name="quantity" value="1" min="1" form="{{ form_id }}" aria-label="{{ 'products.product.quantity' | t }}">
                    <button type="button" aria-label="{{ 'general.accessibility.quantity_add' | t }}" data-yk-qty-step="1">+</button>
                  </div>
                {%- endif -%}
                <button class="yk-product__button yk-product__button--primary" type="submit" form="{{ form_id }}" name="add" data-yk-add>
                  {{ block.settings.add_label | escape }}
                </button>
              </div>
              <p class="yk-product__buy-error" role="alert" hidden data-yk-buy-error></p>

              {%- if block.settings.show_dynamic_checkout -%}
                <div class="yk-product__dynamic" data-yk-buy-available{% unless current_variant.available %} hidden{% endunless %}>
                  {%- if block.settings.dynamic_style == 'shopify' -%}
                    {%- comment -%}Shopify's own Shop Pay button (purple; only its height and corners can be styled){%- endcomment -%}
                    {%- form 'product', product, class: 'yk-product__dynamic-form' -%}
                      <input type="hidden" name="id" value="{{ current_variant.id }}" data-yk-variant-id>
                      {{ form | payment_button }}
                    {%- endform -%}
                  {%- else -%}
                    {%- comment -%}
                      Figma "Buy with shop" button: white with an outline. It opens Shop Pay checkout for the selected
                      variant and quantity through a cart link (/cart/VARIANT:QTY?payment=shop_pay).
                    {%- endcomment -%}
                    <input type="hidden" value="{{ current_variant.id }}" data-yk-variant-id data-yk-shop-variant>
                    <a class="yk-product__button yk-product__button--shop" href="{{ routes.cart_url }}/{{ current_variant.id }}:1?payment=shop_pay" data-yk-shop-pay>
                      <span>Buy with</span>
                      <svg class="yk-product__shop-logo" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 60 25" role="img" aria-label="Shop"><path fill="currentColor" d="M7.74 11.067c-2.35-.509-3.396-.708-3.396-1.612 0-.85.708-1.274 2.125-1.274 1.246 0 2.157.544 2.828 1.609.05.082.155.11.24.066l2.644-1.334a.186.186 0 0 0 .076-.259c-1.098-1.9-3.125-2.94-5.794-2.94-3.507 0-5.686 1.727-5.686 4.47 0 2.914 2.653 3.65 5.006 4.16 2.353.509 3.403.708 3.403 1.612 0 .904-.765 1.33-2.293 1.33-1.41 0-2.457-.644-3.09-1.896a.185.185 0 0 0-.25-.082L.916 16.222a.188.188 0 0 0-.082.253c1.046 2.102 3.194 3.284 6.062 3.284 3.653 0 5.86-1.697 5.86-4.526 0-2.83-2.666-3.65-5.015-4.16v-.006ZM21.909 5.324c-1.5 0-2.824.53-3.776 1.476a.093.093 0 0 1-.158-.067V.7a.185.185 0 0 0-.187-.186H14.48a.185.185 0 0 0-.187.186v18.728c0 .105.083.187.187.187h3.308a.185.185 0 0 0 .187-.187v-8.215c0-1.586 1.217-2.803 2.859-2.803 1.641 0 2.83 1.191 2.83 2.803v8.215c0 .105.082.187.187.187h3.308a.185.185 0 0 0 .186-.187v-8.215c0-3.451-2.264-5.888-5.436-5.888ZM34.056 4.786c-1.796 0-3.478.55-4.687 1.344a.187.187 0 0 0-.06.25l1.458 2.487c.054.089.168.12.256.066a5.812 5.812 0 0 1 3.04-.834c2.887 0 5.01 2.035 5.01 4.725 0 2.292-1.7 3.99-3.853 3.99-1.755 0-2.973-1.022-2.973-2.463 0-.825.351-1.501 1.265-1.979a.183.183 0 0 0 .073-.259L32.21 9.787a.186.186 0 0 0-.224-.08c-1.844.683-3.137 2.327-3.137 4.533 0 3.338 2.66 5.829 6.369 5.829 4.333 0 7.448-3 7.448-7.302 0-4.611-3.624-7.98-8.609-7.98ZM52.342 5.295c-1.673 0-3.169.62-4.26 1.707a.092.092 0 0 1-.158-.066V5.627a.185.185 0 0 0-.186-.186h-3.223a.185.185 0 0 0-.187.186v18.7c0 .104.082.186.187.186h3.308a.185.185 0 0 0 .187-.187v-6.131c0-.083.098-.124.158-.07 1.088 1.012 2.527 1.602 4.174 1.602 3.88 0 6.907-3.138 6.907-7.216 0-4.077-3.03-7.216-6.907-7.216Zm-.626 11.265c-2.207 0-3.88-1.754-3.88-4.074s1.67-4.074 3.88-4.074 3.877 1.726 3.877 4.074c0 2.349-1.644 4.074-3.88 4.074h.003Z"/></svg>
                    </a>
                  {%- endif -%}
                </div>
              {%- endif -%}

              <button class="yk-product__button yk-product__button--outline" type="button" data-yk-notify-open data-yk-buy-sold-out{% if current_variant.available %} hidden{% endif %}>
                {{ block.settings.notify_label | escape }}
              </button>

              {%- if block.settings.show_payment_terms -%}
                <div class="yk-product__terms">
                  {%- form 'product', product, class: 'yk-product__terms-form' -%}
                    <input type="hidden" name="id" value="{{ current_variant.id }}" data-yk-variant-id>
                    {{ form | payment_terms }}
                  {%- endform -%}
                </div>
              {%- endif -%}
            </div>

            <dialog class="yk-notify" aria-labelledby="YkNotifyTitle-{{ section.id }}" data-yk-notify>
              <div class="yk-notify__box">
                <button class="yk-notify__close" type="button" aria-label="{{ 'general.accessibility.close_modal' | t }}" data-yk-notify-close>
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18"/></svg>
                </button>
                <h2 class="yk-notify__title" id="YkNotifyTitle-{{ section.id }}">{{ block.settings.notify_title | escape }}</h2>
                {%- form 'contact', class: 'yk-notify__form', id: 'YkNotifyForm' -%}
                  {%- if form.posted_successfully? -%}
                    <p class="yk-notify__text" data-yk-notify-success>{{ block.settings.notify_success | escape }}</p>
                  {%- else -%}
                    <p class="yk-notify__text">{{ block.settings.notify_text | escape }}</p>
                    {%- if form.errors -%}
                      <p class="yk-notify__error" role="alert">{{ form.errors | default_errors }}</p>
                    {%- endif -%}
                    <label class="yk-notify__label" for="YkNotifyEmail-{{ section.id }}">{{ block.settings.notify_email_label | escape }}</label>
                    <input class="yk-notify__input" id="YkNotifyEmail-{{ section.id }}" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ block.settings.notify_placeholder | escape }}" data-yk-notify-email>
                    <input type="hidden" name="contact[subject]" value="Back in stock request: {{ product.title | escape }}">
                    <input type="hidden" name="contact[body]" value="Please let me know when {{ product.title | escape }} is available again. {{ shop.url }}{{ product.url }}" data-yk-notify-body>
                    <input type="hidden" name="contact[tags]" value="back-in-stock">
                    <button class="yk-product__button yk-product__button--primary yk-notify__submit" type="submit" disabled data-yk-notify-submit>{{ block.settings.notify_button | escape }}</button>
                  {%- endif -%}
                {%- endform -%}
              </div>
            </dialog>

          {%- when 'promo' -%}
            {%- if product.available or block.settings.show_when_sold_out -%}
              <div
                class="yk-product__promo"
                style="--yk-promo-bg: url('{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1200 }}{% else %}{{ 'yk-product-promo.jpg' | asset_url }}{% endif %}');"
                {{ block.shopify_attributes }}
              >
                {%- if block.settings.icon != 'none' -%}{% render 'yk-icon', icon: block.settings.icon %}{%- endif -%}
                <div class="yk-product__promo-text">
                  {%- if block.settings.title != blank -%}<p class="yk-product__promo-title">{{ block.settings.title | escape }}</p>{%- endif -%}
                  {%- if block.settings.text != blank -%}<p>{{ block.settings.text | escape }}</p>{%- endif -%}
                </div>
                {%- if block.settings.link != blank -%}
                  <a class="yk-product__promo-link" href="{{ block.settings.link }}"><span class="visually-hidden">{{ block.settings.title | escape }}</span></a>
                {%- endif -%}
              </div>
            {%- endif -%}

          {%- when 'info_row' -%}
            <div class="yk-product__row" {{ block.shopify_attributes }}>
              {%- if block.settings.icon != 'none' -%}{% render 'yk-icon', icon: block.settings.icon %}{%- endif -%}
              <div class="yk-product__row-text">{{ block.settings.text | replace: '[free_shipping_threshold]', yk_free_shipping }}</div>
            </div>

          {%- when 'custom_liquid' -%}
            <div class="yk-product__liquid" {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "YK Product",
  "class": "yk-product-section",
  "settings": [
    { "type": "checkbox", "id": "show_breadcrumbs", "label": "Show breadcrumbs", "default": true },
    { "type": "text", "id": "zoom_label", "label": "Zoom button label", "default": "Zoom image" },
    { "type": "text", "id": "more_media_label", "label": "More images button label", "default": "Show all images" },
    { "type": "range", "id": "low_stock_threshold", "label": "Low stock threshold", "min": 1, "max": 50, "step": 1, "default": 10, "info": "Shows the low stock note when tracked inventory is at or below this number" },
    { "type": "header", "content": "Badges", "info": "Shown on products that have the matching tag" },
    { "type": "text", "id": "badge_1_tag", "label": "Badge 1 product tag", "default": "Pre-Seasoned" },
    { "type": "text", "id": "badge_1_label", "label": "Badge 1 label", "default": "Pre-Seasoned" },
    { "type": "color", "id": "badge_1_color", "label": "Badge 1 background", "default": "#235fa3" },
    { "type": "color", "id": "badge_1_text_color", "label": "Badge 1 text", "default": "#ffffff" },
    { "type": "text", "id": "badge_2_tag", "label": "Badge 2 product tag", "default": "Bestseller" },
    { "type": "text", "id": "badge_2_label", "label": "Badge 2 label", "default": "Best Seller" },
    { "type": "color", "id": "badge_2_color", "label": "Badge 2 background", "default": "#eecaa1" },
    { "type": "color", "id": "badge_2_text_color", "label": "Badge 2 text", "default": "#000000" }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "badges",
      "name": "Badges and stock",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "low_stock_text", "label": "Low stock text", "default": "Only a few left" },
        { "type": "text", "id": "sold_out_text", "label": "Sold out badge", "default": "Sold Out" }
      ]
    },
    { "type": "title", "name": "Title", "limit": 1, "settings": [] },
    {
      "type": "price",
      "name": "Price and rating",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_compare_price", "label": "Show compare-at price", "default": true },
