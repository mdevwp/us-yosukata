{%- liquid
  assign filters_valid = false
  if results.filters != empty and show_filters
    assign filters_valid = true
  endif

  assign show_sidebar = false
  if filters_valid or show_navigation_filter
    assign show_sidebar = true
  endif
-%}

{%- if show_sidebar -%}
  <form
    class="filter-sidebar"
    id="filter-sidebar"
    data-filter-form
    data-filter-sidebar
    aria-expanded="{% if collapse_filter_bar %}false{% else %}true{% endif %}"
  >
    <div class="filter-sidebar-inner" data-sticky-container>
      {%- if search.terms -%}
        <input
          type="hidden"
          name="q"
          id="SearchFilters--FilterDrawer"
          value="{{ search.terms | escape }}"
        >
      {%- endif -%}

      {%- comment -%} Keep search term within form {%- endcomment -%}
      {%- if results.terms -%}
        <input type="hidden" name="q" value="{{ results.terms | escape }}">
        <input name="options[prefix]" type="hidden" value="last">
      {%- endif -%}

      {%- comment -%} Keep product type within form {%- endcomment -%}
      {%- if results.current_type -%}
        <input type="hidden" name="q" value="{{ results.current_type | escape }}">
      {%- endif -%}

      {%- comment -%} Keep product vendor within form {%- endcomment -%}
      {%- if results.current_vendor -%}
        <input type="hidden" name="q" value="{{ results.current_vendor | escape }}">
      {%- endif -%}

      {%- if show_navigation_filter and navigation_filter_menu != blank -%}
        {%- assign nav_menu = linklists[navigation_filter_menu] -%}
        {%- if nav_menu.links.size > 0 -%}
          <div class="filter-drawer__group animation--filter-drawer-item">
            <button
              type="button"
              class="filter-drawer__group-toggle"
              aria-expanded="{% if collapse_filter_groups %}false{% else %}true{% endif %}"
              aria-controls="navigation-filter-group"
              data-button="group_toggle"
              data-drawer-group-toggle="navigation-filter-group"
            >
              <span class="filter-drawer__group-toggle-inner">
                <span class="filter-drawer__group-toggle-label">
                  {{ navigation_filter_label | default: 'Categories' }}
                </span>
              </span>
              {% render 'icon', icon: 'chevron' %}
            </button>

            <div
              id="navigation-filter-group"
              class="filter-drawer__group-filter-wrapper"
              aria-hidden="{{ collapse_filter_groups }}"
              data-filter-type="navigation"
            >
              <ul class="filter-drawer__list">
                {%- for link in nav_menu.links -%}
                  {% render 'navigation-filter-item', link: link, scope: '--sidebar' %}
                {%- endfor -%}
              </ul>
            </div>
          </div>
        {%- endif -%}
      {%- endif -%}

      {%- for filter in results.filters -%}
        {% render 'filter-drawer-group',
          filter: filter,
          scope: 'sidebar',
          collapse_filter_groups: collapse_filter_groups,
          show_swatch_filters: show_swatch_filters,
          swatch_options: swatch_options,
          show_chip_filters: show_chip_filters,
          chip_options: chip_options,
          chip_layout: chip_layout,
          custom_color_key_map: custom_color_key_map,
          custom_color_value_map: custom_color_value_map
        %}
      {%- endfor -%}
    </div>
  </form>
{%- endif -%}
