<div class="product__description product__block product__block--medium" {{ block.shopify_attributes }}>
  {%- if heading != blank -%}
    <{{ block.settings.title_tag }} class="ff-heading fs-heading-5-base">{{ heading }}</{{ block.settings.title_tag }}>
  {%- endif -%}
  <div class="rte rte--product ff-body {{ block_settings.text_font_class }}">
    {{ content }}
  </div>
</div>

<script>
  document.querySelectorAll('.rte--product p').forEach(function(p) {
    var strong = p.querySelector('strong, b');
    if (strong && strong.textContent.trim() === '') {
      p.style.display = 'none';
    }
  });
</script>
